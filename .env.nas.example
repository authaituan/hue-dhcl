# Sao chép thành `.env` (CẠNH docker-compose.yml trên NAS), tự điền giá trị thật. KHÔNG commit, KHÔNG dán vào chat.
# Đổi `.env` xong phải chạy lại: docker compose up -d --force-recreate (restart thường không nạp lại biến).

# --- Bắt buộc ---
# BẮT BUỘC, để trống thì compose từ chối chạy. Tự sinh chuỗi ngẫu nhiên dài, riêng cho hệ thống này, KHÔNG dùng chuỗi mẫu hay chuỗi đã thấy ở đâu khác
# (xem docs/ai/06_DEPLOYMENT.md mục 1). Lệnh sinh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# IP/dải IPv4 được vào hệ thống, cách nhau dấu phẩy. PHẢI THAY giá trị mẫu bên dưới bằng dải LAN thật (dạng CIDR IPv4, ví dụ 10.47.0.0/16);
# mục sai cú pháp làm app không khởi động. PHẢI giữ 127.0.0.1 (healthcheck). KHÔNG dùng * (cho mọi IP).
CMS_ALLOWED_IPS=127.0.0.1,doi-dai-mang-nay

# --- Cổng ---
# Cổng app lắng nghe trên NAS (chế độ host). Không dùng 5000 (DSM). Phải mở trong Tường lửa DSM.
HOST_PORT=18060

# --- Đăng nhập (tùy chọn, để trống = mặc định của app) ---
# Hạn token các vai trò thường (mặc định 8h).
JWT_EXPIRY=
# Hạn token vai trò TIVI (mặc định 90d).
JWT_EXPIRY_TIVI=
# Số lần đăng nhập sai tối đa / 15 phút / 1 IP (mặc định 20).
LOGIN_IP_MAX_FAILS=

# --- Reverse proxy DSM (chỉ đặt khi có proxy đứng trước app) ---
# IP của proxy tin cậy, để app đọc X-Forwarded-For. Để trống = không tin proxy.
TRUSTED_PROXIES=

# --- SFTP nguồn dữ liệu (cần cho Nạp dữ liệu nguồn và bộ tự động) ---
# Địa chỉ SFTP: 127.0.0.1 hoặc 10.47.31.8 khi compose dùng network_mode: host; nếu đổi sang mạng cầu thì PHẢI là 10.47.31.8.
SFTP_HOST=
# Cổng SFTP của NAS (mặc định của MÃ là 22 nên đặt tường minh).
SFTP_PORT=5454
# Tên đăng nhập SFTP (tài khoản chỉ có quyền đọc thư mục nguồn).
SFTP_USER=
# Mật khẩu SFTP.
SFTP_PASSWORD=
# Danh sách thư mục nguồn, cách nhau dấu phẩy (tối đa 20).
SFTP_DIRS=
# Vân tay khoá máy chủ, dạng SHA256:... hoặc 64 ký tự hex; lấy bằng đúng địa chỉ SFTP_HOST ở trên.
SFTP_HOSTKEY_SHA256=

# --- Bộ tự động nạp SFTP (mặc định TẮT) ---
# Chỉ giá trị 1 mới bật; cần đủ nhóm SFTP_* ở trên, thiếu thì bộ hẹn giờ không khởi động (máy chủ vẫn chạy).
SFTP_SYNC_ENABLED=
# Chu kỳ quét, phút (mặc định 10, tối thiểu 2).
SFTP_SYNC_INTERVAL_MINUTES=
# Số file nạp tối đa mỗi lượt (mặc định 5).
SFTP_SYNC_MAX_FILES=
# Lấy file của N ngày gần nhất (mặc định 3).
SFTP_SYNC_DAYS=
# Số giây file phải giữ nguyên kích thước/mtime mới coi là ghi xong (mặc định 60).
SFTP_STABLE_SECONDS=

# --- Tùy chọn khác (để trống = mặc định của app) ---
# Đặt 0 để TẮT khởi động nóng cache «kết quả phát từ đầu tháng» (chạy ~3 giây sau khi app nghe cổng; có thể tốn CPU vài giây trên DB thật). Trống = bật.
PHAT_WARM=
# Đặt 0 để TẮT làm nóng cache «Hàng tại KTT» (KTT-15: chạy nền sau mỗi lần nạp cặp CSV và 8 giây sau khởi động, tuần tự từng ngày; tốn CPU vài chục giây trên NAS). Trống = bật.
KTT_WARM=
# Số ngày làm nóng tối đa (1..31). Trống = 31; 9 = chỉ các ngày trong cửa sổ nạp (nhẹ hơn).
KTT_WARM_NGAY=
# Giới hạn số dòng mỗi tệp «tải về» (chỉ HẠ được xuống dưới mặc định). Trống = mặc định.
TAIVE_MAX_DONG=
