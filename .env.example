# Sao chép thành `.env` (cùng thư mục với docker-compose.yml) rồi điền giá trị. KHÔNG commit `.env`.

# Khoá ký đăng nhập (JWT). BẮT BUỘC, chuỗi ngẫu nhiên dài. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# IP / dải mạng được phép vào hệ thống (IPv4), cách nhau dấu phẩy. Dải viết dạng CIDR,
# ví dụ 10.47.0.0/16 = mọi máy 10.47.x.x. Phải có 127.0.0.1 để healthcheck của Docker chạy.
# Dấu * = mọi IP (CHỈ để thử, đừng dùng khi chạy thật).
CMS_ALLOWED_IPS=127.0.0.1,10.47.0.0/16

# Cổng app lắng nghe TRỰC TIẾP trên NAS (chế độ host), truy cập http://<IP-NAS>:<cổng>. Không dùng 5000 (cổng DSM),
# không trùng dịch vụ khác, và phải cho phép cổng này trong Tường lửa DSM.
HOST_PORT=18060
