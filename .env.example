# Sao chép thành `.env` (cùng thư mục với docker-compose.yml) rồi điền giá trị. KHÔNG commit `.env`.

# Khoá ký đăng nhập (JWT). BẮT BUỘC, chuỗi ngẫu nhiên dài. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# IP / dải mạng được phép vào hệ thống (IPv4), cách nhau dấu phẩy. Dải viết dạng CIDR,
# ví dụ 10.47.0.0/16 = mọi máy 10.47.x.x. Phải có 127.0.0.1 để healthcheck của Docker chạy.
# Dấu * = mọi IP (CHỈ để thử, đừng dùng khi chạy thật).
CMS_ALLOWED_IPS=127.0.0.1,10.47.0.0/16

# Cổng app lắng nghe TRỰC TIẾP trên NAS (chế độ host), truy cập http://<IP-NAS>:<cổng>. Không dùng 5000 (cổng DSM),
# không trùng dịch vụ khác, và phải cho phép cổng này trong Tường lửa DSM.
HOST_PORT=18060

# --- Thử kết nối SFTP chỉ đọc (scripts/sftp-probe.js — SANLUONG-5b, docs/ai/12_SFTP_PROBE.md). CHƯA dùng bởi server. ---
# Chỉ cần khi chạy công cụ thử kết nối; để trống ở đây, điền giá trị thật vào .env (KHÔNG commit .env).
# Vân tay khoá máy chủ: chạy `node scripts/sftp-probe.js --show-fingerprint` rồi đối chiếu với người quản trị NAS.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# Danh sách thư mục cần liệt kê, cách nhau dấu phẩy. Ví dụ giả: /CSV_Report_000000,/CSV_Report_000001
SFTP_DIRS=
# Dạng SHA256:xxxxxxxx... hoặc hex 64 ký tự
SFTP_HOSTKEY_SHA256=

# --- Đồng bộ SFTP chạy tay (scripts/sftp-sync.js — SANLUONG-5c, docs/ai/13_SFTP_SYNC.md). Dùng thêm các biến SFTP_* ở trên. ---
# Số ngày gần nhất được lấy (hôm nay trừ N ngày, giờ Bangkok). Để trống = 3. Nạp lịch sử dài là việc của 5d.
SFTP_SYNC_DAYS=
# Số giây chờ giữa hai lần liệt kê để biết file đã ghi xong chưa. Để trống = 60.
SFTP_STABLE_SECONDS=
